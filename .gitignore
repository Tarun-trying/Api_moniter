# ============================================================
#  API Monitoring System — Root .gitignore
# ============================================================

# ────────────────────────────────────────────────────────────
# Python / Backend
# ────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.pyo

# Virtual environments
venv/
.venv/
env/
.env/
ENV/

# Distribution / packaging
build/
dist/
*.egg-info/
*.egg

# Unit test / coverage
.pytest_cache/
.coverage
htmlcov/
.tox/

# SQLite databases (local dev DB — never commit)
*.db
*.sqlite3

# dotenv secrets
.env
.env.*
!.env.example

# ────────────────────────────────────────────────────────────
# Node / Frontend
# ────────────────────────────────────────────────────────────
node_modules/
dist/
dist-ssr/
*.local

# Build caches
.cache/
.parcel-cache/
.vite/

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# ────────────────────────────────────────────────────────────
# OS artifacts
# ────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini
ehthumbs.db

# ────────────────────────────────────────────────────────────
# IDE / Editor
# ────────────────────────────────────────────────────────────
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# ────────────────────────────────────────────────────────────
# Misc
# ────────────────────────────────────────────────────────────
*.bak
*.tmp
*.orig
